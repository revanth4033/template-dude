Example:\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 "Aata chusthava"
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 \strokec2 2. Movie\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 The Telugu movie from which the scene comes.\
Example:\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Guntur Kaaram
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 \strokec2 3. Actor\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 The actor shown in the template.\
Example:\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Mahesh Babu
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 \strokec2 4. Emotion\
